{
  "name": "agent-hub",
  "version": "0.1.0",
  "description": "Local-first hub for coding agents: shared skills, rules and MCP, runs, handoff, history, cost advice.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/pavvelltour-web/agent-hub.git" },
  "bugs": { "url": "https://github.com/pavvelltour-web/agent-hub/issues" },
  "homepage": "https://github.com/pavvelltour-web/agent-hub#readme",
  "keywords": ["coding-agents", "claude-code", "codex", "mcp", "skills", "local-first", "handoff"],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "hub": "./bin/hub.js"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "test:all": "node scripts/test-all.mjs",
    "typecheck": "tsc --noEmit",
    "security": "node scripts/security.mjs",
    "hub": "node --disable-warning=ExperimentalWarning bin/hub.js",
    "build": "tsc -p tsconfig.build.json",
    "tokens": "node design/build-tokens.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/adapters/fixtures",
    "!src/history/fixtures",
    "!src/cli/readonly-check.ps1.txt",
    "web",
    "eval/review",
    "packs",
    "templates",
    "modes",
    "rules",
    "registry",
    "stages",
    "design/themes.json",
    "design/tokens.css",
    "design/tokens.json",
    "design/build-tokens.mjs",
    "design/DESIGN-SYSTEM.md",
    "docs",
    "scripts/security.mjs",
    "scripts/test-all.mjs",
    "scripts/install.ps1",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ]
}
